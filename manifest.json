{
  "manifest_version": 3,
  "name": "Hackathon Pipeline Tracker",
  "description": "Capture hackathons from Devfolio, Devpost, Unstop or any website and sync them to your team's shared workspace.",
  "version": "1.0.0",

  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "notifications",
    "scripting",
    "storage"
  ],

  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.devfolio.co/*",
        "*://*.devpost.com/*",
        "*://*.unstop.com/*"
      ],
      "js": ["content/network-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.devfolio.co/*",
        "*://*.devpost.com/*",
        "*://*.unstop.com/*",
        "*://*.dorahacks.io/*",
        "*://*.ethglobal.com/*",
        "*://*.hack2skill.com/*",
        "*://*.hackerearth.com/*"
      ],
      "js": ["content/extractor.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
