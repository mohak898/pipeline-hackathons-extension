rules_version = '2';
// All reads/writes go through the Next.js server (firebase-admin bypasses
// these rules). Browsers and the extension never talk to Firestore directly,
// so lock everything down. The old setup left the database open to anyone
// holding the public API key.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
