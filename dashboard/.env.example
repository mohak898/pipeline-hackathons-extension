# Storage backend: "file" (default; local dev / VPS / Docker with a volume) or "firestore" (Vercel & serverless)
STORAGE=file
# Where the file backend keeps db.json (default: ./.data)
# DATA_DIR=/var/lib/hpt

# Firestore backend: paste the service-account JSON on ONE line (or set GOOGLE_APPLICATION_CREDENTIALS)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"…",…}

# Protects /api/cron/reminders (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=change-me-to-a-long-random-string

# Optional: canonical public URL (used in calendar feed + sign-in links). Defaults to the request host.
# PUBLIC_BASE_URL=https://pipeline.example.com

# Optional: where the landing page's "Get the extension" button points
# NEXT_PUBLIC_EXTENSION_LINK=https://chromewebstore.google.com/detail/…
